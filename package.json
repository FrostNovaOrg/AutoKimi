{
  "name": "autokimi",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare:upstream": "node tools/prepare.mjs",
    "follow:upstream": "node tools/follow-upstream.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:upstream": "node tools/test-upstream.mjs",
    "check": "node tools/check-repo.mjs",
    "package:runtime": "node tools/install.mjs --prepare .artifacts/runtime",
    "install:local": "node tools/install.mjs",
    "test:install": "node tools/smoke-install.mjs",
    "package:release": "node tools/package-release.mjs",
    "check:history": "node tools/check-history.mjs",
    "test:headless": "node tools/smoke-headless.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrostNovaOrg/AutoKimi.git"
  },
  "description": "Model-based permission review for the Kimi Code native TUI and observable headless tasks.",
  "keywords": [
    "kimi-code",
    "ai-agent",
    "tui",
    "tool-permissions",
    "auto-review",
    "headless",
    "agent-orchestration"
  ]
}
